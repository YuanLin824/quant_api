# cocker-compose 使用
PG_USER="quant"
PG_PASS="quant.postgres"
PG_HOST="127.0.0.1"
PG_PORT="5432"
PG_DB="quant_db"

# 项目连接数据库时使用统一连接串 postgres://[user]:[pass]@host:port/db
PG_URL="postgres://${PG_USER}:${PG_PASS}@${PG_HOST}:${PG_PORT}/${PG_DB}"

# cocker-compose 使用
REDIS_USER="quant"
REDIS_PASS="quant.redis"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_DB="0"

# 项目连接数据库时使用统一连接串 redis://[user]:[pass]@host:port[/db]
REDIS_URL="redis://${REDIS_USER}:${REDIS_PASS}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"
REDIS_KEY_PREFIX="quant-"

