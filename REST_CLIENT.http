@baseUrl = http://localhost:3001/api


### 健康检查
GET {{baseUrl}}/health
Content-Type: application/json


### 用户注册
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "QuantAdmin",
  "password": "Quant.Admin"
}


### 用户登录
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "QuantAdmin",
  "password": "Quant.Admin"
}


### 刷新令牌
# @name refresh
POST {{baseUrl}}/auth/refresh
Authorization: Bearer {{login.response.body.data.refreshToken}}


### 用户登出
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.data.refreshToken}}"
}


### 获取用户信息
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{login.response.body.data.accessToken}}


### 修改密码
POST {{baseUrl}}/auth/change-password
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "oldPassword": "Password@123",
  "newPassword": "NewPassword@456"
}


### 登出所有设备
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock API 接口 ==========


### 获取A股贵州茅台行情
GET {{baseUrl}}/stock-api/quote/SH/600519
Authorization: Bearer {{login.response.body.data.accessToken}}


### 获取港股腾讯行情
GET {{baseUrl}}/stock-api/quote/HK/00700
Authorization: Bearer {{login.response.body.data.accessToken}}


### 获取美股苹果行情
GET {{baseUrl}}/stock-api/quote/US/AAPL
Authorization: Bearer {{login.response.body.data.accessToken}}


### 批量获取股票行情
POST {{baseUrl}}/stock-api/quotes
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "SH600519",
    "SZ000651",
    "HK00700"
  ]
}


### 获取K线数据（日K）
GET {{baseUrl}}/stock-api/kline/SH/600519?period=day&count=3
Authorization: Bearer {{login.response.body.data.accessToken}}


### 获取K线数据（周K）
GET {{baseUrl}}/stock-api/kline/HK/00700?period=week
Authorization: Bearer {{login.response.body.data.accessToken}}


### 搜索股票
GET {{baseUrl}}/stock-api/search?keyword=茅台
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 接口 ==========


### Stock SDK - 批量获取A股行情
POST {{baseUrl}}/stock-sdk/quotes/cn
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "600519",
    "000651",
    "000858"
  ]
}


### Stock SDK - 批量获取港股行情
POST {{baseUrl}}/stock-sdk/quotes/hk
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "00700",
    "09988"
  ]
}


### Stock SDK - 批量获取美股行情
POST {{baseUrl}}/stock-sdk/quotes/us
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "AAPL",
    "MSFT"
  ]
}


### Stock SDK - 批量获取基金行情
POST {{baseUrl}}/stock-sdk/funds
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "005827",
    "161725",
    "110011"
  ]
}


### Stock SDK - 搜索股票
GET {{baseUrl}}/stock-sdk/search?keyword=茅台
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 搜索指数
GET {{baseUrl}}/stock-sdk/search?keyword=沪深300
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 搜索基金
GET {{baseUrl}}/stock-sdk/search?keyword=易方达
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 批量行情接口 ==========


### Stock SDK - 获取全部A股行情
GET {{baseUrl}}/stock-sdk/batch/cn
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取全部港股行情
GET {{baseUrl}}/stock-sdk/batch/hk
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取全部美股行情
GET {{baseUrl}}/stock-sdk/batch/us
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 按代码批量获取行情
POST {{baseUrl}}/stock-sdk/batch
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "sh600519",
    "sz000651",
    "hk00700",
    "usAAPL"
  ]
}


### ========== Stock SDK K线接口 ==========


### Stock SDK - 获取A股日K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取港股周K线
GET {{baseUrl}}/stock-sdk/kline/hk/00700?period=weekly
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取美股月K线
GET {{baseUrl}}/stock-sdk/kline/us/AAPL?period=monthly
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取A股5分钟K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519?period=5
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取港股15分钟K线
GET {{baseUrl}}/stock-sdk/kline/hk/00700?period=15
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取美股60分钟K线
GET {{baseUrl}}/stock-sdk/kline/us/AAPL?period=60
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取带MA均线的K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519?period=daily&indicators={"ma":[5,10,20]}
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取带MACD的K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519?indicators={"macd":true}
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取带多个指标的K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519?period=1&indicators={"ma":[5,10,20],"macd":true,"boll":true,"rsi":true}
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取K线信号
GET {{baseUrl}}/stock-sdk/kline/cn/600519/signals?period=daily&maFast=5&maSlow=20
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 其他接口 ==========


### Stock SDK - 获取大单数据
POST {{baseUrl}}/stock-sdk/large-order
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "600519",
    "000651"
  ]
}


### Stock SDK - 获取A股代码列表
GET {{baseUrl}}/stock-sdk/codes/cn
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取港股代码列表
GET {{baseUrl}}/stock-sdk/codes/hk
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取美股代码列表
GET {{baseUrl}}/stock-sdk/codes/us
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取基金代码列表
GET {{baseUrl}}/stock-sdk/codes/fund
Authorization: Bearer {{login.response.body.data.accessToken}}