@baseUrl = http://localhost:3001/api


### 健康检查
GET {{baseUrl}}/health
Content-Type: application/json


### 用户注册
# @name register
# 使用测试账户注册；默认管理员 QuantAdmin 由应用启动时自动创建，重复注册会返回 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "password": "Test@1234"
}


### 用户登录
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "QuantAdmin",
  "password": "Quant.Admin"
}


### 刷新令牌
# @name refresh
POST {{baseUrl}}/auth/refresh
Authorization: Bearer {{login.response.body.data.refreshToken}}


### 用户登出
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.data.refreshToken}}"
}


### 获取用户信息
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{login.response.body.data.accessToken}}


### 修改密码
# oldPassword 须为当前账户密码（登录示例用的是默认管理员 Quant.Admin）
# 执行成功后所有 refreshToken 失效，刷新令牌示例需重新登录
POST {{baseUrl}}/auth/change-password
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "oldPassword": "Quant.Admin",
  "newPassword": "NewPassword@456"
}


### 登出所有设备
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock API 接口 ==========


### 获取A股贵州茅台行情
GET {{baseUrl}}/stock-api/quote/SH/600519
Authorization: Bearer {{login.response.body.data.accessToken}}


### 获取港股腾讯行情
GET {{baseUrl}}/stock-api/quote/HK/00700
Authorization: Bearer {{login.response.body.data.accessToken}}


### 获取美股苹果行情
GET {{baseUrl}}/stock-api/quote/US/AAPL
Authorization: Bearer {{login.response.body.data.accessToken}}


### 批量获取股票行情
POST {{baseUrl}}/stock-api/quotes
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "SH600519",
    "SZ000651",
    "HK00700"
  ]
}


### 获取K线数据（日K）
GET {{baseUrl}}/stock-api/kline/SH/600519?period=day&count=3
Authorization: Bearer {{login.response.body.data.accessToken}}


### 获取K线数据（周K）
GET {{baseUrl}}/stock-api/kline/HK/00700?period=week
Authorization: Bearer {{login.response.body.data.accessToken}}


### 搜索股票
GET {{baseUrl}}/stock-api/search?keyword=茅台
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 接口 ==========


### Stock SDK - 批量获取A股行情
POST {{baseUrl}}/stock-sdk/quotes/cn
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "600519",
    "000651",
    "000858"
  ]
}


### Stock SDK - 批量获取港股行情
POST {{baseUrl}}/stock-sdk/quotes/hk
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "00700",
    "09988"
  ]
}


### Stock SDK - 批量获取美股行情
POST {{baseUrl}}/stock-sdk/quotes/us
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "AAPL",
    "MSFT"
  ]
}


### Stock SDK - 批量获取基金行情
POST {{baseUrl}}/stock-sdk/funds
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "005827",
    "161725",
    "110011"
  ]
}


### Stock SDK - 搜索股票
GET {{baseUrl}}/stock-sdk/search?keyword=茅台
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 搜索指数
GET {{baseUrl}}/stock-sdk/search?keyword=沪深300
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 搜索基金
GET {{baseUrl}}/stock-sdk/search?keyword=易方达
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 批量行情接口 ==========


### Stock SDK - 获取全部A股行情
GET {{baseUrl}}/stock-sdk/batch/cn
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取全部港股行情
GET {{baseUrl}}/stock-sdk/batch/hk
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取全部美股行情（指定批次大小与并发数）
GET {{baseUrl}}/stock-sdk/batch/us?batchSize=100&concurrency=5
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 按代码批量获取行情
# batchSize / concurrency 为可选字段
POST {{baseUrl}}/stock-sdk/batch
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "sh600519",
    "sz000651",
    "hk00700",
    "usAAPL"
  ],
  "batchSize": 100,
  "concurrency": 5
}


### ========== Stock SDK K线接口 ==========


### Stock SDK - 获取A股日K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取港股周K线
GET {{baseUrl}}/stock-sdk/kline/hk/00700?period=weekly
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取美股月K线
GET {{baseUrl}}/stock-sdk/kline/us/AAPL?period=monthly
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取A股1分钟K线（自动定位当前/前一交易日）
GET {{baseUrl}}/stock-sdk/kline/cn/600519?period=1
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取A股1分钟K线（显式指定交易日）
GET {{baseUrl}}/stock-sdk/kline/cn/600519?period=1&startDate=20240115&endDate=20240115
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取A股5分钟K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519?period=5
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取指定日期范围的K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519?startDate=20240101&endDate=20240131
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取港股15分钟K线
GET {{baseUrl}}/stock-sdk/kline/hk/00700?period=15
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取美股60分钟K线
GET {{baseUrl}}/stock-sdk/kline/us/AAPL?period=60
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取带MA均线的K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519?period=daily&indicators={"ma":[5,10,20]}
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取带MACD的K线
GET {{baseUrl}}/stock-sdk/kline/cn/600519?indicators={"macd":true}
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取带多个指标的K线
# 注意：分钟周期（period=1/5/15/30/60）下 indicators 不生效
GET {{baseUrl}}/stock-sdk/kline/cn/600519?period=daily&indicators={"ma":[5,10,20],"macd":true,"boll":true,"rsi":true}
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取日线信号（默认近 1 个月）
GET {{baseUrl}}/stock-sdk/kline/cn/600519/signals?period=daily
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取周线信号（默认近 6 个月）
GET {{baseUrl}}/stock-sdk/kline/cn/600519/signals?period=weekly
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取月线信号（默认近 36 个月）
GET {{baseUrl}}/stock-sdk/kline/cn/600519/signals?period=monthly
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取K线信号（显式指定范围与 MA 参数）
GET {{baseUrl}}/stock-sdk/kline/cn/600519/signals?period=daily&startDate=20240101&endDate=20240131&maFast=5&maSlow=20
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 其他接口 ==========


### Stock SDK - 获取大单数据
POST {{baseUrl}}/stock-sdk/large-order
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "codes": [
    "600519",
    "000651"
  ]
}


### Stock SDK - 获取A股代码列表
GET {{baseUrl}}/stock-sdk/codes/cn
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取港股代码列表
GET {{baseUrl}}/stock-sdk/codes/hk
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取美股代码列表
GET {{baseUrl}}/stock-sdk/codes/us
Authorization: Bearer {{login.response.body.data.accessToken}}


### Stock SDK - 获取基金代码列表
GET {{baseUrl}}/stock-sdk/codes/fund
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 标的代码接口 ==========
# 定时任务每天 09:00（开盘前）自动同步各市场代码；以下用于手动触发与查询


### 标的代码 - 手动触发同步（首次初始化 / 失败补跑）
POST {{baseUrl}}/stock-sdk/symbols/sync
Authorization: Bearer {{login.response.body.data.accessToken}}


### 标的代码 - 各市场数量统计
GET {{baseUrl}}/stock-sdk/symbols
Authorization: Bearer {{login.response.body.data.accessToken}}


### 标的代码 - A股列表
GET {{baseUrl}}/stock-sdk/symbols?market=cn
Authorization: Bearer {{login.response.body.data.accessToken}}


### 标的代码 - 美股列表
GET {{baseUrl}}/stock-sdk/symbols?market=us
Authorization: Bearer {{login.response.body.data.accessToken}}


### 标的代码 - 港股列表
GET {{baseUrl}}/stock-sdk/symbols?market=hk
Authorization: Bearer {{login.response.body.data.accessToken}}


### 标的代码 - 基金列表
GET {{baseUrl}}/stock-sdk/symbols?market=fund
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 板块资金流接口 ==========
# 定时任务每天 17:00（收盘后）自动采集行业板块；以下用于手动触发与查询


### 板块资金流 - 手动触发采集（默认行业板块 / 当日）
POST {{baseUrl}}/stock-sdk/sectors/sync
Authorization: Bearer {{login.response.body.data.accessToken}}


### 板块资金流 - 采集概念板块的 5 日资金流
POST {{baseUrl}}/stock-sdk/sectors/sync
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "sectorType": "concept",
  "indicator": "5day"
}


### 板块资金流 - 演练（只取数不落库）
POST {{baseUrl}}/stock-sdk/sectors/sync
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "dryRun": true
}


### 板块资金流 - 查询最近一批
GET {{baseUrl}}/stock-sdk/sectors
Authorization: Bearer {{login.response.body.data.accessToken}}


### 板块资金流 - 查询指定交易日
GET {{baseUrl}}/stock-sdk/sectors?date=2026-09-11&sectorType=industry
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 个股资金流接口 ==========
# 定时任务每天 16:00（收盘后）自动采集；以下用于手动触发与查询


### 个股资金流 - 手动触发采集（默认当日，全市场数千条）
POST {{baseUrl}}/stock-sdk/fund-flows/sync
Authorization: Bearer {{login.response.body.data.accessToken}}


### 个股资金流 - 采集 5 日排名
POST {{baseUrl}}/stock-sdk/fund-flows/sync
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "indicator": "5day"
}


### 个股资金流 - 演练（只取数不落库）
POST {{baseUrl}}/stock-sdk/fund-flows/sync
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "dryRun": true
}


### 个股资金流 - 查询最近一批（前 50 名）
GET {{baseUrl}}/stock-sdk/fund-flows
Authorization: Bearer {{login.response.body.data.accessToken}}


### 个股资金流 - 分页查询指定交易日
GET {{baseUrl}}/stock-sdk/fund-flows?date=2026-09-14&page=2&pageSize=100
Authorization: Bearer {{login.response.body.data.accessToken}}


### ========== Stock SDK 大盘资金流接口 ==========
# 定时任务每天 16:30（收盘后）自动采集；以下用于手动触发与查询


### 大盘资金流 - 手动触发采集
POST {{baseUrl}}/stock-sdk/market-flows/sync
Authorization: Bearer {{login.response.body.data.accessToken}}


### 大盘资金流 - 演练（只取数不落库）
POST {{baseUrl}}/stock-sdk/market-flows/sync
Content-Type: application/json
Authorization: Bearer {{login.response.body.data.accessToken}}

{
  "dryRun": true
}


### 大盘资金流 - 查询最近一个月
GET {{baseUrl}}/stock-sdk/market-flows
Authorization: Bearer {{login.response.body.data.accessToken}}


