# compiled output
/dist
/node_modules
/build

# WESTOCK 技能包自带的 Windows 二进制（3.1MB，入库会让仓库体积翻倍且无法增量压缩，
# 可由 westock-data/scripts/setup.* 重新获取）
westock-data/westock-data.exe

# Logs
# winston 生产环境输出目录：按小时轮转，归档为 .gz（如 2026-09-11-10.info.log.gz），
# 仅靠 *.log 无法覆盖 .gz，故整目录忽略
logger_prod/
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

